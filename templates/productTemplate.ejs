<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Product Specification - <%= productCode %></title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: 'Arial', 'Helvetica', sans-serif;
      background-color: #ffffff;
      padding: 0;
      margin: 0;
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }

    .container {
      width: 100%;
      margin: 0 auto;
      background-color: #ffffff;
    }

    /* Header - Using table for better PDF support */
    .header {
      background-color: #34495e;
      padding: 30px 40px;
      width: 100%;
    }

    .header-table {
      width: 100%;
      border-collapse: collapse;
    }

    .header-table td {
      vertical-align: middle;
    }

    .logo-section {
      text-align: left;
    }

    .logo {
      font-size: 28px;
      font-weight: 700;
      color: #ffffff;
      letter-spacing: 6px;
      margin-bottom: 5px;
    }

    .tagline {
      font-size: 9px;
      color: #95a5a6;
      letter-spacing: 2.5px;
      text-transform: uppercase;
      font-weight: 400;
    }

    .badge-cell {
      text-align: right;
    }

    .badge {
      background-color: #f39c12;
      color: white;
      padding: 12px 24px;
      border-radius: 3px;
      font-size: 11px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 1.2px;
      display: inline-block;
    }

    /* Product Content */
    .product-content {
      background-color: #ffffff;
      padding: 0;
    }

    .product-code {
      font-size: 20px;
      font-weight: 600;
      color: #2c3e50;
      padding: 40px 40px 25px 40px;
      text-align: center;
      background-color: #ffffff;
    }

    .product-image-container {
      text-align: center;
      background-color: #ffffff;
      padding: 25px 40px 50px 40px;
    }

    .product-image-container img {
      max-width: 320px;
      height: auto;
      border-radius: 2px;
    }

    /* Specifications Table */
    .spec-section {
      background-color: #ffffff;
      padding: 0 0 40px 0;
    }

    .spec-header {
      background-color: #34495e;
      color: white;
      padding: 15px 40px;
      font-size: 12px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 1.8px;
      text-align: center;
      margin: 0 40px 0 40px;
    }

    .spec-table-wrapper {
      padding: 0 40px;
    }

    .spec-table {
      width: 100%;
      border-collapse: collapse;
      background-color: #ffffff;
      border: 1px solid #ecf0f1;
    }

    .spec-table tr {
      border-bottom: 1px solid #ecf0f1;
    }

    .spec-table tr:last-child {
      border-bottom: none;
    }

    .spec-label {
      width: 45%;
      padding: 15px 25px;
      font-size: 16x;
      font-weight: 600;
      color: #2c3e50;
      text-transform: uppercase;
      letter-spacing: 0.6px;
      background-color: #ffffff;
      vertical-align: top;
    }

    .spec-value {
      width: 55%;
      padding: 15px 25px;
      font-size: 16x;
      color: #2c3e50;
      font-weight: 400;
      background-color: #ffffff;
      border-left: 4px solid #f39c12;
      vertical-align: top;
    }

    /* Footer */
    .footer {
      background-color: #34495e;
      padding: 22px 40px;
      text-align: center;
    }

    .footer-links {
      margin-bottom: 6px;
    }

    .footer-link {
      font-size: 11px;
      color: #ecf0f1;
      text-decoration: none;
      font-weight: 400;
      display: inline;
    }

    .footer-divider {
      color: #7f8c8d;
      font-size: 11px;
      margin: 0 10px;
    }

    .copyright {
      font-size: 9px;
      color: #95a5a6;
      margin-top: 4px;
      font-weight: 300;
    }

    /* Print-specific styles for PDF generation */
    @media print {
      body {
        background-color: white;
      }

      .container {
        width: 100%;
      }

      @page {
        margin: 0;
        size: A4 portrait;
      }
    }
  </style>
</head>

<body>
  <div class="container">
    <!-- Header -->
    <div class="header">
      <table class="header-table">
        <tr>
          <td class="logo-section">
            <div class="logo">SKYDECOR</div>
            <div class="tagline">High Gloss Laminates</div>
          </td>
          <td class="badge-cell">
            <div class="badge">Product Specification</div>
          </td>
        </tr>
      </table>
    </div>

    <!-- Product Content -->
    <div class="product-content">
      <!-- Product Code -->
      <div class="product-code"><%= productCode %></div>

      <!-- Product Image -->
      <div class="product-image-container">
        <img src="<%= image %>" alt="<%= productName %>" onerror="this.style.display='none'">
      </div>
    </div>

    <!-- Specifications Section -->
    <div class="spec-section">
      <div class="spec-header">Product Specifications</div>

      <div class="spec-table-wrapper">
        <table class="spec-table">

          
          <tr>
            <td class="spec-label">Product Code</td>
            <td class="spec-value"><%= productCode %></td>
          </tr>

          <tr>
            <td class="spec-label">Product Name</td>
            <td class="spec-value"><%= productName %></td>
          </tr>

          <% if (designName) { %>
          <tr>
            <td class="spec-label">Design Name</td>
            <td class="spec-value"><%= designName %></td>
          </tr>
          <% } %>

          <tr>
            <td class="spec-label">Category</td>
            <td class="spec-value"><%= category %></td>
          </tr>

          <tr>
            <td class="spec-label">Subcategory</td>
            <td class="spec-value"><%= subCategory %></td>
          </tr>

          <tr>
            <td class="spec-label">Texture</td>
            <td class="spec-value"><%= texture %> (<%= textureCode %>)</td>
          </tr>

          <tr>
            <td class="spec-label">Size</td>
            <td class="spec-value"><%= size %></td>
          </tr>

          <tr>
            <td class="spec-label">Thickness</td>
            <td class="spec-value"><%= thickness %></td>
          </tr>

          <tr>
            <td class="spec-label">Width</td>
            <td class="spec-value"><%= width %></td>
          </tr>
        </table>
      </div>
    </div>

    <!-- Footer -->
    <div class="footer">
      <div class="footer-links">
        <span class="footer-link">www.skydecor.in</span>
        <span class="footer-divider">|</span>
        <span class="footer-link">info@skydecor.in</span>
        <span class="footer-divider">|</span>
        <span class="footer-link">+91 8800777777</span>
      </div>
      <div class="copyright">© 2025 Skydecor. All Rights Reserved</div>
    </div>
  </div>
</body>

</html>
