<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Product Specification - <%= productCode %>
  </title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: 'Montserrat', 'Arial', 'Helvetica', sans-serif;
      background-color: #ffffff;
      padding: 0;
      margin: 0;
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }

    .container {
      width: 100%;
      margin: 0 auto;
      background-color: #ffffff;
    }

    /* Header - Using table for better PDF support */
    .header {
      background-color: #34495e;
      padding: 20px 40px;
      width: 100%;
    }

    .header-table {
      width: 100%;
      border-collapse: collapse;
    }

    .header-table td {
      vertical-align: middle;
    }

    .logo-section {
      text-align: left;
    }

    .logo-img {
      max-width: 200px;
      height: auto;
      display: block;
    }

    .badge-cell {
      text-align: right;
    }

    .badge {
      background-color: #f39c12;
      color: white;
      padding: 10px 20px;
      border-radius: 3px;
      font-size: 10px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 1px;
      display: inline-block;
    }

    /* Product Content */
    .product-content {
      background-color: #ffffff;
      padding: 0;
    }

    .product-code {
      font-size: 24px;
      font-weight: 500;
      color: #2c3e50;
      padding: 25px 40px 20px 40px;
      text-align: center;
      background-color: #ffffff;
    }

    .product-image-container {
      text-align: center;
      background-color: #ffffff;
      padding: 20px 40px 30px 40px;
    }

    .product-image-container img {
      width: 380px;
      height: auto;
      max-height: 760px;
      border-radius: 2px;
    }

    /* PAGE BREAK - Ensures page 2 starts here */
    .page-break {
      page-break-before: always;
      break-before: page;
    }

    /* Specifications Table */
    .spec-section {
      background-color: #ffffff;
      padding: 0 0 30px 0;
    }

    .spec-header {
      background-color: #34495e;
      color: white;
      padding: 12px 40px;
      font-size: 22px;
      font-weight: 500;
      text-transform: uppercase;
      letter-spacing: 1.5px;
      text-align: center;
      margin: 0 40px 0 40px;
    }

    .spec-table-wrapper {
      padding: 0 40px;
    }

    .spec-table {
      width: 100%;
      border-collapse: collapse;
      background-color: #ffffff;
      border: 1px solid #ecf0f1;
    }

    .spec-table tr {
      border-bottom: 1px solid #ecf0f1;
    }

    .spec-table tr:last-child {
      border-bottom: none;
    }

    .spec-label {
      width: 45%;
      padding: 14px 20px;
      font-size: 16px;
      font-weight: 500;
      color: #2c3e50;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      background-color: #ffffff;
      vertical-align: top;
    }

    .spec-value {
      width: 55%;
      padding: 14px 20px;
      font-size: 16px;
      color: #2c3e50;
      font-weight: 400;
      background-color: #ffffff;
      border-left: 4px solid #f39c12;
      vertical-align: top;
    }

    /* Footer */
    .footer {
      background-color: #34495e;
      padding: 18px 40px;
      text-align: center;
      position: fixed;
      bottom: -2;
      left: 0;
      width: 100%;
    }

    .footer-links {
      margin-bottom: 5px;
    }

    .footer-link {
      font-size: 16px;
      color: #ecf0f1;
      text-decoration: none;
      font-weight: 400;
      display: inline;
    }

    .footer-divider {
      color: #7f8c8d;
      font-size: 10px;
      margin: 0 8px;
    }

    .copyright {
      font-size: 8px;
      color: #95a5a6;
      margin-top: 3px;
      font-weight: 300;
    }

    /* Print-specific styles for PDF generation */
    @media print {
      body {
        background-color: white;
      }

      .container {
        width: 100%;
      }

      @page {
        margin: 0;
        size: A4 portrait;
      }
    }
  </style>
</head>

<body>
  <div class="container">
    <!-- PAGE 1: Header, Product Code & Image -->
    <!-- Header -->
    <div class="header">
      <table class="header-table">
        <tr>
          <td class="logo-section">
            <img src="https://skydecor.in/images/logo/ai-white.png" alt="Skydecor Logo" class="logo-img">
          </td>
          <td class="badge-cell">
            <div class="badge">Product Specification</div>
          </td>
        </tr>
      </table>
    </div>

    <!-- Product Content -->
    <div class="product-content">
      <!-- Product Code -->
      <div class="product-code">
        <%= productCode %>
      </div>

      <!-- Product Image -->
      <div class="product-image-container">
        <img src="<%= image %>" alt="<%= productName %>" onerror="this.style.display='none'">
      </div>
    </div>

    <!-- PAGE 2: Specifications -->
    <!-- Specifications Section -->
    <div class="spec-section">
      <div class="spec-header">Product Specifications</div>

      <div class="spec-table-wrapper">
        <table class="spec-table">
          <tr>
            <td class="spec-label">Product Type</td>
            <td class="spec-value">
              <%= productType %>
            </td>
          </tr>

          <tr>
            <td class="spec-label">Product Code</td>
            <td class="spec-value">
              <%= productCode %>
            </td>
          </tr>

          <tr>
            <td class="spec-label">Product Name</td>
            <td class="spec-value">
              <%= productName %>
            </td>
          </tr>

          <% if (designName) { %>
            <tr>
              <td class="spec-label">Design Name</td>
              <td class="spec-value">
                <%= designName %>
              </td>
            </tr>
            <% } %>

              <tr>
                <td class="spec-label">Category</td>
                <td class="spec-value">
                  <%= category %>
                </td>
              </tr>

              <tr>
                <td class="spec-label">Subcategory</td>
                <td class="spec-value">
                  <%= subCategory %>
                </td>
              </tr>

              <tr>
                <td class="spec-label">Texture</td>
                <td class="spec-value">
                  <%= texture %> (<%= textureCode %>)
                </td>
              </tr>

              <tr>
                <td class="spec-label">Size</td>
                <td class="spec-value">
                  <%= size %>
                </td>
              </tr>

              <tr>
                <td class="spec-label">Width</td>
                <td class="spec-value">
                  <%= width %>
                </td>
              </tr>

              <tr>
                <td class="spec-label">Thickness</td>
                <td class="spec-value">
                  <%= thickness %>
                </td>
              </tr>

              


        </table>
      </div>
    </div>

    <!-- Footer -->
    <div class="footer">
      <div class="footer-links">
        <span class="footer-link">www.skydecor.in</span>
        <span class="footer-divider">|</span>
        <span class="footer-link">info@skydecor.in</span>
        <span class="footer-divider">|</span>
        <span class="footer-link">+91 8800777731</span>
      </div>
      <div class="copyright">© 2025 Skydecor. All Rights Reserved</div>
    </div>
  </div>
</body>

</html>
