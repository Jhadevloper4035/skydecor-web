<!DOCTYPE html>
<html class="no-js" lang="zxx">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="x-ua-compatible" content="ie=edge" />
    <title>Skydecor - Premium Quality Laminates Design Collections</title>
    <meta name="description" content="" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Favicon -->
        <link rel="icon" type="image/png" href="/site/favicon/favicon-96x96.png" />
  <link rel="icon" type="image/svg+xml" href="/site/favicon.svg" />
  <link rel="shortcut icon" href="/public/site/favicon.ico" />
  <link rel="apple-touch-icon" sizes="180x180" href="/site/apple-touch-icon.png" />
  <meta name="apple-mobile-web-app-title" content="Skydecor India" />
  <link rel="manifest" href="/site/site.webmanifest" />

    <!-- CSS ============================================ -->

    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="/css/bootstrap.min.css" />
    <!-- Icon Font CSS -->
    <link rel="stylesheet" href="/css/icons.min.css" />
    <!-- Plugins CSS -->
    <link rel="stylesheet" href="/css/plugins.css" />
    <!-- Main Style CSS -->
    <link rel="stylesheet" href="/css/style.css" />
  </head>

  <body>
    <%- include("../partials/header") %> <% const
    tabletBanner=page.banners.find(b=> b.device == "tablet").image; const
    mobileBanner = page.banners.find(b => b.device == "mobile").image; const
    desktopBanner = page.banners.find(b => b.device == "desktop").image; %>

    <div
      class="breadcrumb-area pt-35 pb-35 bg-gray-3"
      style="background-image: url('<%= desktopBanner %>')"
    >
      <div class="container"></div>
    </div>

    <style>
      @media (max-width: 1024px) {
        .breadcrumb-area {
          background-image: url("<%= tabletBanner %>") !important;
        }
      }

      @media (max-width: 767px) {
        .breadcrumb-area {
          background-image: url("<%= mobileBanner %>") !important;
        }
      }
    </style>

    <div class="container-fluid p-0">
      <nav aria-label="breadcrumb">
        <ol class="breadcrumb pdp-breadcrumb px-4">
          <li class="breadcrumb-item"><a href="/">HOME</a></li>
          <li class="breadcrumb-item"><a href="/products">PRODUCTS</a></li>
          <li class="breadcrumb-item active">
            <a href="/products/<%= category %>"><%= category %></a>
          </li>
        </ol>
      </nav>
    </div>

    <div class="shop-area pb-100">
      <div class="container">
        <div class="row flex-row-reverse">
          <div class="col-lg-12 col-md-12">
            <div class="shop-bottom-area mt-35">
              <div class="tab-content jump">
                <div id="shop-1" class="tab-pane active">
                  <div class="row" id="shop-area">
                    <%- include('../partials/product-card', { products: products
                    }) %>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <%- include("../partials/footer") %> <%-
    include("../partials/product-modal") %>

    <!-- Include LazyLoad JS at bottom of page -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/vanilla-lazyload/17.6.1/lazyload.min.js"></script>

    <script src="/js/vendor/modernizr-3.11.7.min.js"></script>
    <script src="/js/vendor/jquery-v3.6.0.min.js"></script>
    <script src="/js/vendor/jquery-migrate-v3.3.2.min.js"></script>
    <script src="/js/vendor/popper.min.js"></script>
    <script src="/js/vendor/bootstrap.min.js"></script>
    <script src="/js/plugins.js"></script>
    <!-- Ajax Mail -->
    <script src="/js/ajax-mail.js"></script>
    <!-- Main JS -->
    <script src="/js/main.js"></script>

    <script>
      // Wait for DOM to be fully loaded
      document.addEventListener("DOMContentLoaded", function () {
        var lazyLoadInstance = new LazyLoad({
          elements_selector: ".lazyload",
          threshold: 300,
          // Callback when image starts loading
          callback_loading: function (el) {
          
          },
          // Callback when image loads successfully
          callback_loaded: function (el) {
           
          },
          // Callback when image fails to load
          callback_error: function (el) {
            console.error("Error loading:", el.dataset.src);
            // Fallback to a placeholder image
            el.src = "/path/to/placeholder-image.jpg";
          },
        });
      });
    </script>
  </body>
</html>
