<!DOCTYPE html>
<html class="no-js" lang="zxx">

<head>
    <meta charset="utf-8" />
    <meta http-equiv="x-ua-compatible" content="ie=edge" />
    <title>Thank You - Skydecor</title>
    <meta name="description" content="" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Favicon -->
    <link rel="shortcut icon" type="image/x-icon" href="/img/favicon.png" />

    <!-- CSS ============================================ -->

    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="/css/bootstrap.min.css" />
    <!-- Icon Font CSS -->
    <link rel="stylesheet" href="/css/icons.min.css" />
    <!-- Plugins CSS -->
    <link rel="stylesheet" href="/css/plugins.css" />

    <!-- Main Style CSS -->
    <link rel="stylesheet" href="/css/style.css" />

    <style>
        .thank-you-section {
            min-height: 70vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 60px 20px;
            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
        }

        .thank-you-container {
            background: #ffffff;
            border-radius: 20px;
            padding: 60px 40px;
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.1);
            text-align: center;
            max-width: 600px;
            width: 100%;
        }

        .success-icon {
            width: 80px;
            height: 80px;
            background: #28a745;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 30px;
            animation: scaleIn 0.5s ease-in-out;
        }

        .success-icon i {
            font-size: 40px;
            color: #ffffff;
        }

        @keyframes scaleIn {
            0% {
                transform: scale(0);
                opacity: 0;
            }

            100% {
                transform: scale(1);
                opacity: 1;
            }
        }

        .thank-you-title {
            font-size: 36px;
            font-weight: 700;
            color: #2c3e50;
            margin-bottom: 20px;
            line-height: 1.2;
        }

        .thank-you-message {
            font-size: 18px;
            color: #7f8c8d;
            margin-bottom: 15px;
            line-height: 1.6;
        }

        .company-name {
            font-weight: 600;
            color: #3498db;
        }

        .back-button {
            display: inline-block;
            margin-top: 30px;
            padding: 14px 40px;
            background: #3498db;
            color: #ffffff;
            text-decoration: none;
            border-radius: 50px;
            font-size: 16px;
            font-weight: 600;
            transition: all 0.3s ease;
            box-shadow: 0 4px 15px rgba(52, 152, 219, 0.3);
        }

        .back-button:hover {
            background: #2980b9;
            color: #ffffff;
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(52, 152, 219, 0.4);
        }

        .back-button i {
            margin-right: 8px;
        }

        .divider {
            width: 60px;
            height: 4px;
            background: #3498db;
            margin: 25px auto;
            border-radius: 2px;
        }

        /* Mobile Responsive */
        @media (max-width: 768px) {
            .thank-you-section {
                min-height: auto;
                padding: 40px 15px;
            }

            .thank-you-container {
                padding: 40px 25px;
                border-radius: 15px;
            }

            .success-icon {
                width: 70px;
                height: 70px;
                margin-bottom: 25px;
            }

            .success-icon i {
                font-size: 35px;
            }

            .thank-you-title {
                font-size: 28px;
                margin-bottom: 15px;
            }

            .thank-you-message {
                font-size: 16px;
                margin-bottom: 12px;
            }

            .back-button {
                padding: 12px 35px;
                font-size: 15px;
                margin-top: 25px;
            }
        }

        @media (max-width: 480px) {
            .thank-you-container {
                padding: 35px 20px;
            }

            .thank-you-title {
                font-size: 24px;
            }

            .thank-you-message {
                font-size: 15px;
            }
        }
    </style>
</head>

<body>
    <%- include("../partials/header") %>

        <div class="thank-you-section">
            <div class="thank-you-container">
                <div class="success-icon">
                    <i class="fa fa-check"></i>
                </div>

                <h1 class="thank-you-title">Thank You!</h1>

                <div class="divider"></div>

                <p class="thank-you-message">
                    Your submission has been received successfully.
                </p>
                <p class="thank-you-message">
                    Our team at <span class="company-name">Skydecor Team</span> will get back to you shortly.
                </p>
                <p class="thank-you-message">
                    We appreciate your interest in our premium quality laminates.
                </p>

                <a href="/" class="back-button">
                    <i class="fa fa-home"></i> Back to Home
                </a>
            </div>
        </div>

        <%- include("../partials/footer") %>

            <!-- jQuery -->
            <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
            <script src="/js/vendor/modernizr-3.11.7.min.js"></script>
            <script src="/js/vendor/jquery-v3.6.0.min.js"></script>
            <script src="/js/vendor/jquery-migrate-v3.3.2.min.js"></script>
            <script src="/js/vendor/popper.min.js"></script>
            <script src="/js/vendor/bootstrap.min.js"></script>
            <script src="/js/plugins.js"></script>
            <script src="/js/main.js"></script>
</body>

</html>