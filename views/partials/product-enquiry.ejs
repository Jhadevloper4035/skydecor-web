 
 <style>

  /* ========================================
   ENQUIRY MODAL STYLES
   ======================================== */

/* Modal Overlay */
.modal-backdrop {
  background-color: rgba(0, 0, 0, 0.6);
  backdrop-filter: blur(4px);
}

/* Modal Container */
#enquiryModal .modal-dialog {
  max-width: 650px;
  margin: 1.75rem auto;
}

#enquiryModal .modal-content {
  border: none;
  border-radius: 20px;
  box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
  overflow: hidden;
  animation: modalSlideIn 0.4s ease-out;
}

@keyframes modalSlideIn {
  from {
    opacity: 0;
    transform: translateY(-50px) scale(0.95);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

/* Modal Header */
#enquiryModal .modal-header {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  padding: 1.5rem 2rem;
  border-bottom: none;
}

#enquiryModal .modal-title {
  font-size: 1.5rem;
  font-weight: 600;
  letter-spacing: 0.3px;
  display: flex;
  align-items: center;
  color: #fff;
}

#enquiryModal .modal-title i {
  font-size: 1.3rem;
  opacity: 0.9;
}

#enquiryModal .btn-close {
  background-color: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
  opacity: 1;
  width: 32px;
  height: 32px;
  padding: 0;
  transition: all 0.3s ease;
  filter: brightness(0) invert(1);
}

#enquiryModal .btn-close:hover {
  background-color: rgba(255, 255, 255, 0.3);
  transform: rotate(90deg);
}

/* Modal Body */
#enquiryModal .modal-body {
  padding: 2rem;
  background-color: #f8f9fa;
}

#enquiryModal .text-muted {
  font-size: 0.95rem;
  color: #6c757d !important;
}

/* Form Styles */
#productEnquiryForm .form-label {
  font-weight: 500;
  color: #2d3748;
  margin-bottom: 0.5rem;
  font-size: 0.9rem;
  letter-spacing: 0.2px;
}

#productEnquiryForm .form-control,
#productEnquiryForm .form-select {
  border: 2px solid #e2e8f0;
  border-radius: 10px;
  padding: 0.7rem 1rem;
  font-size: 0.95rem;
  transition: all 0.3s ease;
  background-color: white;
}

#productEnquiryForm .form-control:focus,
#productEnquiryForm .form-select:focus {
  border-color: #667eea;
  box-shadow: 0 0 0 0.2rem rgba(102, 126, 234, 0.15);
  background-color: white;
}

#productEnquiryForm .form-control::placeholder {
  color: #a0aec0;
  font-size: 0.9rem;
}

#productEnquiryForm .form-control[readonly] {
  background-color: #f7fafc;
  border-color: #cbd5e0;
  color: #4a5568;
  font-weight: 500;
}

/* Textarea */
#productEnquiryForm textarea.form-control {
  resize: vertical;
  min-height: 100px;
}

/* Checkboxes */
#productEnquiryForm .form-check {
  padding-left: 1.8rem;
  margin-bottom: 0.8rem;
}

#productEnquiryForm .form-check-input {
  width: 1.2rem;
  height: 1.2rem;
  border: 2px solid #cbd5e0;
  border-radius: 5px;
  cursor: pointer;
  transition: all 0.3s ease;
}

#productEnquiryForm .form-check-input:checked {
  background-color: #667eea;
  border-color: #667eea;
}

#productEnquiryForm .form-check-input:focus {
  box-shadow: 0 0 0 0.2rem rgba(102, 126, 234, 0.15);
}

#productEnquiryForm .form-check-label {
  font-size: 0.9rem;
  color: #4a5568;
  cursor: pointer;
  line-height: 1.5;
}

#productEnquiryForm .form-check-label a {
  text-decoration: none;
  font-weight: 500;
  transition: color 0.2s ease;
}

#productEnquiryForm .form-check-label a:hover {
  text-decoration: underline;
}

/* Required Asterisk */
.text-danger {
  color: #e53e3e !important;
}

/* Submit Button */
#submitBtn {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border: none;
  padding: 0.9rem 2rem;
  font-size: 1rem;
  font-weight: 600;
  border-radius: 10px;
  letter-spacing: 0.5px;
  transition: all 0.3s ease;
  box-shadow: 0 4px 15px rgba(102, 126, 234, 0.3);
  text-transform: uppercase;
}

#submitBtn:hover {
  transform: translateY(-2px);
  box-shadow: 0 6px 20px rgba(102, 126, 234, 0.4);
  background: linear-gradient(135deg, #764ba2 0%, #667eea 100%);
}

#submitBtn:active {
  transform: translateY(0);
}

#submitBtn:disabled {
  background: #cbd5e0;
  cursor: not-allowed;
  transform: none;
  box-shadow: none;
}

/* Form Message Alerts */
#formMessage .alert {
  border-radius: 10px;
  border: none;
  padding: 1rem;
  margin-bottom: 1.5rem;
  font-size: 0.9rem;
  animation: fadeIn 0.3s ease;
}

@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(-10px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

#formMessage .alert-success {
  background-color: #d4edda;
  color: #155724;
}

#formMessage .alert-danger {
  background-color: #f8d7da;
  color: #721c24;
}

/* Row Spacing */
#productEnquiryForm .row.g-3 {
  margin-bottom: 0;
}

/* ========================================
   RESPONSIVE DESIGN
   ======================================== */

/* Tablets and below */
@media (max-width: 768px) {
  #enquiryModal .modal-dialog {
    margin: 0.5rem;
    max-width: calc(100% - 1rem);
  }

  #enquiryModal .modal-content {
    border-radius: 15px;
  }

  #enquiryModal .modal-header {
    padding: 1.25rem 1.5rem;
  }

  #enquiryModal .modal-title {
    font-size: 1.3rem;
  }

  #enquiryModal .modal-body {
    padding: 1.5rem;
  }

  #productEnquiryForm .col-md-6 {
    margin-bottom: 0;
  }

  #submitBtn {
    padding: 0.8rem 1.5rem;
    font-size: 0.95rem;
  }
}

/* Mobile phones */
@media (max-width: 576px) {
  #enquiryModal .modal-dialog {
    margin: 0;
    max-width: 100%;
    height: 100vh;
  }

  #enquiryModal .modal-content {
    border-radius: 0;
    height: 100%;
  }

  #enquiryModal .modal-header {
    padding: 1rem 1.25rem;
  }

  #enquiryModal .modal-title {
    font-size: 1.2rem;
  }

  #enquiryModal .modal-title i {
    font-size: 1.1rem;
  }

  #enquiryModal .modal-body {
    padding: 1.25rem;
  }

  #enquiryModal .text-muted {
    font-size: 0.85rem;
    margin-bottom: 1.5rem !important;
  }

  #productEnquiryForm .form-label {
    font-size: 0.85rem;
  }

  #productEnquiryForm .form-control,
  #productEnquiryForm .form-select {
    padding: 0.6rem 0.85rem;
    font-size: 0.9rem;
  }

  #productEnquiryForm .form-check-label {
    font-size: 0.85rem;
  }

  #submitBtn {
    padding: 0.75rem 1.25rem;
    font-size: 0.9rem;
  }

  #enquiryModal .btn-close {
    width: 28px;
    height: 28px;
  }
}

/* Extra small devices */
@media (max-width: 375px) {
  #enquiryModal .modal-header {
    padding: 0.9rem 1rem;
  }

  #enquiryModal .modal-body {
    padding: 1rem;
  }

  #enquiryModal .modal-title {
    font-size: 1.1rem;
  }

  #productEnquiryForm .form-control,
  #productEnquiryForm .form-select {
    font-size: 0.85rem;
  }
}

/* ========================================
   LOADING STATE
   ======================================== */

#submitBtn.loading {
  position: relative;
  color: transparent;
  pointer-events: none;
}

#submitBtn.loading::after {
  content: "";
  position: absolute;
  width: 20px;
  height: 20px;
  top: 50%;
  left: 50%;
  margin-left: -10px;
  margin-top: -10px;
  border: 3px solid rgba(255, 255, 255, 0.3);
  border-top-color: white;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

/* ========================================
   ACCESSIBILITY ENHANCEMENTS
   ======================================== */

#productEnquiryForm .form-control:focus-visible,
#productEnquiryForm .form-select:focus-visible,
#productEnquiryForm .form-check-input:focus-visible {
  outline: 2px solid #667eea;
  outline-offset: 2px;
}

/* High contrast mode support */
@media (prefers-contrast: high) {
  #enquiryModal .modal-content {
    border: 2px solid #000;
  }

  #productEnquiryForm .form-control,
  #productEnquiryForm .form-select {
    border-width: 2px;
  }
}

/* Reduced motion support */
@media (prefers-reduced-motion: reduce) {
  #enquiryModal .modal-content,
  #productEnquiryForm .form-control,
  #productEnquiryForm .form-select,
  #submitBtn,
  #enquiryModal .btn-close {
    animation: none;
    transition: none;
  }
}

 </style>
 
<!-- Enquiry Modal -->
<div class="modal fade" id="enquiryModal" tabindex="-1" aria-labelledby="enquiryModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="enquiryModalLabel">
          <i class="fas fa-envelope me-2"></i>Product Enquiry
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <p class="text-center text-muted mb-4">Fill out the form below and our team will get back to you shortly</p>

        <div id="formMessage"></div>

        <form id="productEnquiryForm" novalidate>
          <div class="row g-3">
            <div class="col-md-6">
              <label for="fullName" class="form-label">Full Name <span class="text-danger">*</span></label>
              <input type="text" class="form-control" id="fullName" name="fullName" required
                placeholder="Enter your full name" minlength="3">
              <div class="invalid-feedback">Please enter a valid name (minimum 3 characters).</div>
            </div>
            <div class="col-md-6">
              <label for="email" class="form-label">Email Address <span class="text-danger">*</span></label>
              <input type="email" class="form-control" id="email" name="email" required
                placeholder="your.email@example.com">
              <div class="invalid-feedback">Please enter a valid email address.</div>
            </div>
            <div class="col-md-6">
              <label for="phone" class="form-label">Phone Number <span class="text-danger">*</span></label>
              <input type="tel" class="form-control" id="phone" name="phone" required 
                placeholder="+91 XXXXX XXXXX" maxlength="10">
              <div class="invalid-feedback">Please enter a valid 10-digit phone number.</div>
            </div>

            <div class="col-md-6">
              <label for="estimatedQuantity" class="form-label">Estimated Quantity</label>
              <input type="text" class="form-control" id="estimatedQuantity" name="estimatedQuantity"
                placeholder="e.g., 50 sheets">
              <div class="invalid-feedback">Please enter a valid quantity.</div>
            </div>

            <div class="col-12">
              <label for="productInterest" class="form-label">Product Interest <span
                  class="text-danger">*</span></label>
              <input type="text" class="form-control" id="productInterest" name="productInterest"
                value="<%= product.productCode %> - <%= product.productName %>" readonly>
            </div>

            <div class="col-12">
              <label for="message" class="form-label">Message / Requirements <span
                  class="text-danger">*</span></label>
              <textarea class="form-control" id="message" name="message" rows="4" required
                placeholder="Please describe your requirements, project details, or any specific questions..." minlength="10"></textarea>
              <div class="invalid-feedback">Please enter your message (minimum 10 characters).</div>
            </div>
            <div class="col-12">
              <div class="form-check">
                <input class="form-check-input" type="checkbox" id="terms" name="terms" required>
                <label class="form-check-label" for="terms">
                  I agree to the <a href="#" class="text-primary">Terms & Conditions</a> and <a href="#"
                    class="text-primary">Privacy Policy</a> <span class="text-danger">*</span>
                </label>
                <div class="invalid-feedback d-block" id="termsError" style="display: none !important;">
                  You must agree to the terms and conditions.
                </div>
              </div>
            </div>
            <div class="col-12">
              <button type="submit" class="btn btn-primary w-100" id="submitBtn">
                <i class="fas fa-paper-plane me-2"></i>Submit Enquiry
              </button>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<script>
  // Real-time validation functions
  const validators = {
    fullName: (value) => {
      const trimmed = value.trim();
      if (trimmed.length < 3) {
        return 'Name must be at least 3 characters long';
      }
      if (!/^[a-zA-Z\s]+$/.test(trimmed)) {
        return 'Name should only contain letters and spaces';
      }
      return null;
    },

    email: (value) => {
      const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
      if (!emailRegex.test(value)) {
        return 'Please enter a valid email address';
      }
      return null;
    },

    phone: (value) => {
      // Remove any spaces, dashes, or special characters
      const cleanPhone = value.replace(/\D/g, '');
      
      if (cleanPhone.length !== 10) {
        return 'Phone number must be exactly 10 digits';
      }
      if (!/^[6-9]\d{9}$/.test(cleanPhone)) {
        return 'Please enter a valid Indian phone number (starting with 6-9)';
      }
      return null;
    },

    message: (value) => {
      const trimmed = value.trim();
      if (trimmed.length < 10) {
        return 'Message must be at least 10 characters long';
      }
      return null;
    }
  };

  // Live validation on input
  function setupLiveValidation() {
    const form = document.getElementById('productEnquiryForm');
    const inputs = form.querySelectorAll('input:not([type="checkbox"]), textarea');

    inputs.forEach(input => {
      // Validate on blur (when user leaves the field)
      input.addEventListener('blur', function() {
        validateField(this);
      });

      // Clear error on focus
      input.addEventListener('focus', function() {
        this.classList.remove('is-invalid');
        this.classList.remove('is-valid');
      });

      // Real-time validation on input
      input.addEventListener('input', function() {
        if (this.classList.contains('is-invalid') || this.classList.contains('is-valid')) {
          validateField(this);
        }
      });
    });

    // Special handling for phone number - only allow numbers
    const phoneInput = document.getElementById('phone');
    phoneInput.addEventListener('input', function(e) {
      // Remove any non-digit characters
      this.value = this.value.replace(/\D/g, '').slice(0, 10);
    });

    // Terms checkbox validation
    const termsCheckbox = document.getElementById('terms');
    const termsError = document.getElementById('termsError');
    
    termsCheckbox.addEventListener('change', function() {
      if (this.checked) {
        this.classList.remove('is-invalid');
        termsError.style.display = 'none';
      }
    });
  }

  // Validate individual field
  function validateField(field) {
    const fieldName = field.name;
    const value = field.value;
    const feedbackElement = field.nextElementSibling;

    // Skip validation for readonly fields
    if (field.readOnly) return true;

    // Check if field has a validator
    if (validators[fieldName]) {
      const error = validators[fieldName](value);
      
      if (error) {
        field.classList.add('is-invalid');
        field.classList.remove('is-valid');
        if (feedbackElement && feedbackElement.classList.contains('invalid-feedback')) {
          feedbackElement.textContent = error;
        }
        return false;
      } else {
        field.classList.remove('is-invalid');
        field.classList.add('is-valid');
        return true;
      }
    }

    // Default validation for required fields
    if (field.hasAttribute('required') && !value.trim()) {
      field.classList.add('is-invalid');
      field.classList.remove('is-valid');
      return false;
    }

    field.classList.remove('is-invalid');
    field.classList.add('is-valid');
    return true;
  }

  // Validate entire form
  function validateForm(form) {
    let isValid = true;
    const inputs = form.querySelectorAll('input:not([type="checkbox"]):not([readonly]), textarea');

    inputs.forEach(input => {
      if (!validateField(input)) {
        isValid = false;
      }
    });

    // Validate terms checkbox
    const termsCheckbox = document.getElementById('terms');
    const termsError = document.getElementById('termsError');
    
    if (!termsCheckbox.checked) {
      termsCheckbox.classList.add('is-invalid');
      termsError.style.display = 'block';
      isValid = false;
    }

    return isValid;
  }

  // Show message in modal
  function showMessage(message, type) {
    const formMessage = document.getElementById('formMessage');
    const alertClass = type === 'success' ? 'alert-success' : 'alert-danger';
    const icon = type === 'success' ? 'fa-check-circle' : 'fa-exclamation-circle';

    formMessage.innerHTML = `
      <div class="alert ${alertClass} alert-dismissible fade show" role="alert">
        <i class="fas ${icon} me-2"></i>${message}
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
      </div>
    `;

    // Auto dismiss after 5 seconds
    setTimeout(() => {
      const alert = formMessage.querySelector('.alert');
      if (alert) {
        alert.classList.remove('show');
        setTimeout(() => {
          formMessage.innerHTML = '';
        }, 150);
      }
    }, 5000);
  }

  // Handle form submission
  async function handleSubmit(event) {
    event.preventDefault();
    event.stopPropagation();
    
    const form = document.getElementById('productEnquiryForm');
    const submitBtn = document.getElementById('submitBtn');

    // Validate form
    if (!validateForm(form)) {
      showMessage('Please fix the errors in the form before submitting.', 'error');
      // Scroll to first error
      const firstError = form.querySelector('.is-invalid');
      if (firstError) {
        firstError.scrollIntoView({ behavior: 'smooth', block: 'center' });
        firstError.focus();
      }
      return false;
    }

    // Prepare form data
    const formData = {
      fullName: document.getElementById('fullName').value.trim(),
      email: document.getElementById('email').value.trim(),
      phone: document.getElementById('phone').value.trim(),
      estimatedQuantity: document.getElementById('estimatedQuantity').value.trim(),
      productInterest: document.getElementById('productInterest').value.trim(),
      message: document.getElementById('message').value.trim(),
      terms: document.getElementById('terms').checked
    };

 

    // Disable submit button and show loading state
    submitBtn.disabled = true;
    submitBtn.classList.add('loading');
    const originalBtnText = submitBtn.innerHTML;
    submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>Sending...';

    try {
   
      
      const response = await fetch('/api/lead/productEnquiry', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify(formData)
      });

    

      const result = await response.json();
   

      if (response.ok && result.success) {
        showMessage(result.message || 'Thank you for your enquiry! Our team will contact you shortly.', 'success');
        
        // Reset form after successful submission
        setTimeout(() => {
          form.reset();
          form.querySelectorAll('.is-valid').forEach(el => el.classList.remove('is-valid'));
          
          // Close modal after 2 seconds
          setTimeout(() => {
            const modal = bootstrap.Modal.getInstance(document.getElementById('enquiryModal'));
            if (modal) {
              modal.hide();
            }
          }, 2000);
        }, 1000);
      } else {
        showMessage(result.message || 'Something went wrong. Please try again.', 'error');
      }
    } catch (error) {
      console.error('Error submitting form:', error); // Debug log
      showMessage('Failed to submit enquiry. Please check your connection and try again.', 'error');
    } finally {
      // Re-enable submit button
      submitBtn.disabled = false;
      submitBtn.classList.remove('loading');
      submitBtn.innerHTML = originalBtnText;
    }

    return false;
  }

  // Initialize validation when DOM is ready
  document.addEventListener('DOMContentLoaded', function() {
    setupLiveValidation();
    
    // Attach form submit handler
    const form = document.getElementById('productEnquiryForm');
    if (form) {
      form.addEventListener('submit', handleSubmit);
    }
  });

  // Reset validation when modal is closed
  const enquiryModal = document.getElementById('enquiryModal');
  if (enquiryModal) {
    enquiryModal.addEventListener('hidden.bs.modal', function() {
      const form = document.getElementById('productEnquiryForm');
      form.reset();
      form.querySelectorAll('.is-valid, .is-invalid').forEach(el => {
        el.classList.remove('is-valid', 'is-invalid');
      });
      document.getElementById('formMessage').innerHTML = '';
    });
  }
</script>

<style>
